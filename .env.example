# Firebase Configuration
NUXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NUXT_PUBLIC_FIREBASE_APP_ID=your_app_id
OPENAI_API_KEY=your_openai_api_key_here

# ─── LINE 登入 ────────────────────────────────────────────────
# 以下四個全部是機密。變數名**絕對不能加 NUXT_PUBLIC_ 前綴** ——
# 那個前綴會讓 Nuxt 把值打包進前端 bundle，等於直接公開。
# 沒設的話按登入會導回編輯器並顯示「登入服務尚未設定完成」，不會白畫面。

# LINE Developers → 你的 Provider → LINE Login channel → Basic settings
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# 回呼網址預設從請求本身推導（<origin>/api/auth/line/callback），
# 所以測試站與正式站可以共用同一份設定，只要兩個網域都登記進 LINE 後台的
# Callback URL。前面還有別的代理、推導不出正確網址時才需要用這個寫死。
# LINE_LOGIN_REDIRECT_URI=https://example.com/api/auth/line/callback

# Firebase service account，用來簽 custom token（把 LINE 身分換成 Firebase 登入）。
# 來源：Firebase Console → 專案設定 → 服務帳戶 → 產生新的私密金鑰，
# 下載的 JSON 裡的 client_email 與 private_key。
#
# 這把私鑰可以繞過所有 Firestore 規則讀寫整個資料庫，權限遠大於上面的
# OpenAI 金鑰，放進 Amplify 環境變數時要意識到 console 有權限的人都看得到。
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# 兩種寫法都吃：整段 PEM 做 base64（建議，一行塞得下），
# 或是從 JSON 直接複製過來、換行是字面上 \n 的原始內容。
FIREBASE_PRIVATE_KEY=base64_encoded_pem_or_raw_pem_with_escaped_newlines

# 便利貼資料集合的後綴（測試用）
# 留空或 none = 正式資料：queue_pending / queue_history / tokens / stats_daily
# 設為 _dev = 測試資料：queue_pending_dev / queue_history_dev / tokens_dev / stats_daily_dev
# （Amplify 的環境變數不接受空值，正式站那一列要填 none 來表達「不加後綴」）
# 註：system 集合（啟用中 token、GPS 圍籬、大螢幕影片等設定）不受影響，兩邊共用
# 目前 firestore.rules 只寫了空值與 _dev 這兩組 match。要換成其他後綴，
# 得先去 firestore.rules 補上對應的 match 區塊並重新部署，否則整組集合會被規則擋下。
NUXT_PUBLIC_FIRESTORE_SUFFIX=

# Google Tag Manager
# 只有 GTM- 開頭的正規編號會生效，其他值（含留空）一律不載入 GTM。
# 測試站要關掉就填 none —— Amplify 的環境變數不接受空字串，只能用非空的值表達「關閉」。
NUXT_PUBLIC_GTM_ID=GTM-XXXXXXX
