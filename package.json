{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:mobile": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "fabric": "^7.1.0",
    "firebase": "^12.8.0",
    "gsap": "^3.14.2",
    "html-to-image": "^1.11.13",
    "nuxt": "^4.3.0",
    "qrcode": "^1.5.4",
    "sass": "^1.97.3",
    "vue": "^3.5.27",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4"
  }
}
