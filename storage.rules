rules_version = '2';

// WillMusic 數位應援便利貼 —— Cloud Storage 安全規則

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null;
    }

    // ── 便利貼手繪圖 ──────────────────────────────────────
    // 前台使用者未登入就要能上傳（便利貼本來就是公開投稿）。
    //
    // 只允許 create 不允許 update，擋掉覆寫別人圖片的可能。這之所以安全，
    // 是因為檔名帶了不可預測的隨機碼（見 useFirestore 的 randomFileSuffix）：
    // 若檔名只用 doc ID，而有 token 時 doc ID 就是印在店內 QR code 上的 token，
    // 攻擊者搶先上傳同名檔案就能讓真正的顧客永遠上傳失敗。
    //
    // 這裡擋不住的是「匿名灌爆儲存空間」—— 那是匿名上傳的本質問題，
    // 規則層無解，真要處理得靠 App Check 或改成經由伺服器上傳。
    match /note_drawings/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType == 'image/png';
      allow update: if false;
      allow delete: if isStaff();
    }

    // ── 大螢幕插播影片 ────────────────────────────────────
    // 只有後台會上傳與刪除；大螢幕要能讀取播放
    match /canvas_interstitial/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 其餘一律拒絕
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
