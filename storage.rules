rules_version = '2';

// WillMusic 數位應援便利貼 —— Cloud Storage 安全規則

service firebase.storage {
  match /b/{bucket}/o {

    // 後台／大螢幕／掃碼頁是帳號密碼登入；前台顧客是 LINE Login 換來的
    // custom token。兩者一定要分開判斷，理由與 firestore.rules 的同名 function
    // 相同（只寫 request.auth != null 的話，顧客一登入就能換掉大螢幕播的影片）。
    function isStaff() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isMember() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    // ── 便利貼手繪圖 ──────────────────────────────────────
    // 手繪圖是在送出流程裡上傳的（createNote 之前），而送出要求 LINE 登入，
    // 所以這裡跟著收成會員限定。原本開放匿名上傳時擋不住「灌爆儲存空間」，
    // 收斂之後至少有了可追查、可封鎖的身分。
    //
    // 只允許 create 不允許 update，擋掉覆寫別人圖片的可能。這之所以安全，
    // 是因為檔名帶了不可預測的隨機碼（見 useFirestore 的 randomFileSuffix）：
    // 若檔名只用 doc ID，而有 token 時 doc ID 就是印在店內 QR code 上的 token，
    // 攻擊者搶先上傳同名檔案就能讓真正的顧客永遠上傳失敗。
    match /note_drawings/{fileName} {
      allow read: if true;
      allow create: if isMember()
                    && request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType == 'image/png';
      allow update: if false;
      allow delete: if isStaff();
    }

    // ── 大螢幕插播影片 ────────────────────────────────────
    // 只有後台會上傳與刪除；大螢幕要能讀取播放
    match /canvas_interstitial/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 其餘一律拒絕
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
