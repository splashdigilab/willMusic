rules_version = '2';

// WillMusic 數位應援便利貼 —— Firestore 安全規則
//
// 設計原則：前台是「公開投稿箱」，任何人都能投、也都能看牆上的內容，
// 但**不能修改或刪除別人的東西**。所有破壞性操作一律要求登入。
//
// 規則是依照程式碼裡實際存在的每一個查詢寫的。改動任何 Firestore 操作時，
// 記得回來確認這裡也要跟著調整，否則會在前台看到 permission-denied。
//
// ── 兩組資料集合 ────────────────────────────────────────────
// 前端由 NUXT_PUBLIC_FIRESTORE_SUFFIX 決定連到哪一組（見 app/utils/collections.ts）：
//   空值 = queue_pending / queue_history / tokens / stats_daily
//   _dev = queue_pending_dev / queue_history_dev / tokens_dev / stats_daily_dev
// 規則語言沒有迴圈或巨集，所以 match 區塊只能一組組寫。判斷條件全部抽成下面的
// function 共用，兩組 match 的差別只有「對應的 tokens 集合路徑」由呼叫端傳入。
// 要再開第三組測試資料時，複製一組 match 區塊、把集合名稱與 tokens 路徑一起改掉即可。
//
// system 集合刻意不分組（啟用中的 token、GPS 圍籬、大螢幕影片等設定兩邊共用），
// 所以它只有一份 match。

service cloud.firestore {
  match /databases/{database}/documents {

    // 後台、大螢幕（/canvas）、掃碼頁都走 Firebase Auth 登入
    function isStaff() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    // 憑證有效期限與前台 checkTokenStatus() 的 30 分鐘一致。
    // 只在前端判斷的話，顧客把結帳時的 QR code 截圖下來就能永久使用。
    function tokenUnexpired(tokenDoc) {
      return tokenDoc.createdAt is timestamp
             && request.time < tokenDoc.createdAt + duration.value(30, 'm');
    }

    // 後台是否要求必須帶憑證才能上傳。
    // 判定方式必須與 editor.vue 一致：文件不存在或 enabled 非 true 都視為不需要。
    // system 不分正式／測試，所以這裡是固定路徑。
    function tokenRequired() {
      return exists(/databases/$(database)/documents/system/editor_token_requirement)
             && get(/databases/$(database)/documents/system/editor_token_requirement)
                  .data.get('enabled', false) == true;
    }

    // tokenRef 由呼叫端傳入：正式組指向 tokens、測試組指向 tokens_dev。
    // 寫死成 tokens 的話，測試站的投稿會拿測試 token 去對正式集合查，永遠查不到。
    function hasUsableToken(tokenRef) {
      return exists(tokenRef)
             && get(tokenRef).data.status == 'unused'
             && tokenUnexpired(get(tokenRef).data);
    }

    // ── queue_pending 的投稿條件 ────────────────────────────
    // 前台未登入即可投稿，但：
    //   1. doc ID 必須等於 token —— moveToHistory 與去重邏輯都依賴這個不變式，
    //      不強制的話可以建立 queue_pending/A 卻帶 token:'B'，歷史紀錄就會錯位
    //   2. 後台開啟 Token 驗證時，必須真的持有一張未使用且未過期的憑證。
    //      前台的 checkTokenStatus() 只是體驗，繞過前端直接打 API 就失效了
    //   3. 限制欄位與長度，避免被塞任意資料
    function canCreateNote(noteId, tokenRef) {
      return noteId == incoming().token
             && incoming().status == 'waiting'
             && incoming().content is string
             && incoming().content.size() <= 1000
             && incoming().style is map
             && incoming().token is string
             && incoming().keys().hasOnly(
                  ['content', 'style', 'token', 'timestamp', 'status']
                )
             && (!tokenRequired() || hasUsableToken(tokenRef));
    }

    // ── tokens 的更新條件 ──────────────────────────────────
    // 前台送出成功時要把 unused 改成 used —— 只允許這一種轉換、
    // 只能動 status 這個欄位，而且憑證必須還在 30 分鐘有效期內
    function canUpdateToken() {
      return isStaff()
             || (
               resource.data.status == 'unused'
               && incoming().status == 'used'
               && incoming().diff(resource.data).affectedKeys().hasOnly(['status'])
               && tokenUnexpired(resource.data)
             );
    }

    // ── stats_daily 的寫入條件 ─────────────────────────────
    // 前台上傳成功後要累加計數（未登入狀態），所以必須開放寫入。
    // 限制欄位並要求 date 與 doc ID 一致，避免被塞入任意資料；
    // 計數本身仍可能被灌水，但這只是營運數字，沒有安全影響。
    function canWriteDailyStat(dateKey) {
      return incoming().keys().hasOnly(
               ['date', 'total', 'hours', 'updatedAt']
             )
             && incoming().date == dateKey;
    }

    // ══ 正式資料 ══════════════════════════════════════════

    // 待播佇列，也是前台的投稿入口
    match /queue_pending/{noteId} {
      // 首頁、等待頁與大螢幕都要讀；內容本來就會公開展示
      allow read: if true;

      allow create: if canCreateNote(
                         noteId,
                         /databases/$(database)/documents/tokens/$(noteId)
                       );

      // 送出後就不能再改；只有大螢幕播完或後台管理才會刪
      allow update: if false;
      allow delete: if isStaff();
    }

    // 已播放
    match /queue_history/{noteId} {
      allow read: if true;
      // 只有大螢幕（moveToHistory）與後台會寫入或清理
      allow create, update, delete: if isStaff();
    }

    // 上傳憑證
    match /tokens/{tokenId} {
      // checkTokenStatus 要讀單一文件。doc ID 是 Firestore 隨機 ID，
      // 猜不到；list 不開放，所以也無法列舉。
      allow get: if true;
      allow list: if isStaff();

      // 只有後台可以發憑證
      allow create: if isStaff();

      allow update: if canUpdateToken();
      allow delete: if isStaff();
    }

    // 每日上傳統計（預聚合）
    match /stats_daily/{dateKey} {
      // 只有後台會看統計
      allow read: if isStaff();
      allow create, update: if canWriteDailyStat(dateKey);
    }

    // ══ 測試資料（NUXT_PUBLIC_FIRESTORE_SUFFIX=_dev）══════════
    // 條件與正式組完全相同，只有集合名稱與 tokens 路徑帶了 _dev。

    match /queue_pending_dev/{noteId} {
      allow read: if true;

      allow create: if canCreateNote(
                         noteId,
                         /databases/$(database)/documents/tokens_dev/$(noteId)
                       );

      allow update: if false;
      allow delete: if isStaff();
    }

    match /queue_history_dev/{noteId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /tokens_dev/{tokenId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if canUpdateToken();
      allow delete: if isStaff();
    }

    match /stats_daily_dev/{dateKey} {
      allow read: if isStaff();
      allow create, update: if canWriteDailyStat(dateKey);
    }

    // ── system/*：設定文件（正式與測試共用）────────────────────
    match /system/{docId} {
      // 前台要讀 editor_token_requirement 與 editor_geo_fence，
      // 大螢幕要讀 canvas_video，掃碼頁要讀 active_token
      allow read: if true;
      allow write: if isStaff();
    }

    // 其餘一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
