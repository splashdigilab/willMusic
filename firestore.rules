rules_version = '2';

// WillMusic 數位應援便利貼 —— Firestore 安全規則
//
// 設計原則：牆上的內容任何人都能看、編輯器不登入也能玩，
// 但**送出一定要 LINE 登入**，而且不能修改或刪除別人的東西。
// 所有破壞性操作一律限後台。
//
// 例外：正式站還沒換成 LINE 登入版之前，正式組集合同時接受舊版的匿名投稿。
// 見下面「【過渡期】」那一段，正式站換版之後要拿掉。
//
// 規則是依照程式碼裡實際存在的每一個查詢寫的。改動任何 Firestore 操作時，
// 記得回來確認這裡也要跟著調整，否則會在前台看到 permission-denied。
//
// ── 兩組資料集合 ────────────────────────────────────────────
// 前端由 NUXT_PUBLIC_FIRESTORE_SUFFIX 決定連到哪一組（見 app/utils/collections.ts）：
//   空值 = queue_pending / queue_history / tokens / stats_daily / users / user_quota /
//          banned_users / note_owners
//   _dev = 以上每一個都加 _dev
// 規則語言沒有迴圈或巨集，所以 match 區塊只能一組組寫。判斷條件全部抽成下面的
// function 共用，兩組 match 的差別只有「對應的 tokens 集合路徑」由呼叫端傳入。
// 要再開第三組測試資料時，複製一組 match 區塊、把集合名稱與 tokens 路徑一起改掉即可。
//
// system 集合刻意不分組（啟用中的 token、GPS 圍籬、大螢幕影片等設定兩邊共用），
// 所以它只有一份 match。

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 兩種身分，絕對不能混為一談 ────────────────────────────
    // 後台／大螢幕／掃碼頁是 Firebase Auth 的帳號密碼（sign_in_provider = password）。
    // 前台顧客是 LINE Login 換來的 custom token（sign_in_provider = custom）。
    //
    // 這兩個一定要分開判斷。曾經 isStaff() 只寫 `request.auth != null`，
    // 那是在「只有後台會登入」的前提下成立的；顧客一旦也能登入，那份規則等於
    // 把清空佇列、發放憑證、改 system 設定、換掉大螢幕影片的權限一起送出去。
    //
    // sign_in_provider 是 Firebase 簽發 ID token 時自己填的，前端偽造不了，
    // 所以不需要另外用 Admin SDK 補 custom claim，既有的後台帳號也不用動。
    function isStaff() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // 前台會員（LINE 登入）。送出便利貼的最低門檻。
    function isMember() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'custom';
    }

    function incoming() {
      return request.resource.data;
    }

    // 憑證有效期限與前台 checkTokenStatus() 的 30 分鐘一致。
    // 只在前端判斷的話，顧客把結帳時的 QR code 截圖下來就能永久使用。
    function tokenUnexpired(tokenDoc) {
      return tokenDoc.createdAt is timestamp
             && request.time < tokenDoc.createdAt + duration.value(30, 'm');
    }

    // 後台是否要求必須帶憑證才能上傳。
    // 判定方式必須與 editor.vue 一致：文件不存在或 enabled 非 true 都視為不需要。
    // system 不分正式／測試，所以這裡是固定路徑。
    function tokenRequired() {
      return exists(/databases/$(database)/documents/system/editor_token_requirement)
             && get(/databases/$(database)/documents/system/editor_token_requirement)
                  .data.get('enabled', false) == true;
    }

    // tokenRef 由呼叫端傳入：正式組指向 tokens、測試組指向 tokens_dev。
    // 寫死成 tokens 的話，測試站的投稿會拿測試 token 去對正式集合查，永遠查不到。
    function hasUsableToken(tokenRef) {
      return exists(tokenRef)
             && get(tokenRef).data.status == 'unused'
             && tokenUnexpired(get(tokenRef).data);
    }

    // ── queue_pending 的投稿條件 ────────────────────────────
    // 瀏覽與編輯都不需要登入，但**送出一定要**：
    //   0. 必須是 LINE 會員，而且同一批寫入的 note_owners 記的是自己（見下面）。
    //      這是前台唯一的身分約束，後續的封鎖與限流都建立在它上面。只在前端擋是
    //      沒用的，繞過 UI 直接用 Firebase SDK 打這個集合就進來了
    //   0a. 不在停權名單上（banned_users/{uid}）。只擋這一個動作：被封鎖的人
    //       仍然可以瀏覽、製作、下載自己的圖，只是送不上牆
    //   0b. 必須先在 user_quota/{uid} 預約過這個 doc ID（見上面的「預約制」）
    //   1. doc ID 必須等於 token —— moveToHistory 與去重邏輯都依賴這個不變式，
    //      不強制的話可以建立 queue_pending/A 卻帶 token:'B'，歷史紀錄就會錯位
    //   2. 後台開啟 Token 驗證時，必須真的持有一張未使用且未過期的憑證。
    //      前台的 checkTokenStatus() 只是體驗，繞過前端直接打 API 就失效了。
    //      （QR token 機制目前停用中，LINE 登入上線後不再依賴它，但規則留著）
    //   3. 限制欄位與長度，避免被塞任意資料
    //
    // 停權只檢查在這裡，不檢查在預約（canWriteQuota）：被封鎖的人就算預約成功，
    // 也換不到便利貼；兩邊都檢查只是多花一次讀取。
    //
    // ── 投稿者不寫在便利貼上 ──────────────────────────────
    // 便利貼是公開可讀的（首頁一次讀 100 張），uid 就是 LINE 使用者編號，
    // 寫在便利貼上等於公開給所有人。所以投稿者存在另一份 note_owners/{noteId}，
    // 只有本人與後台讀得到，而且必須跟便利貼**同一批**寫入（writeBatch／transaction）：
    // 這裡用 getAfter 要求「這一批寫完之後，這張便利貼的投稿者是我」，
    // canCreateNoteOwner 則要求「這一批裡同時建立了這張便利貼」。
    function canCreateNote(noteId, tokenRef, quotaRef, bannedRef, ownerRef) {
      return isMember()
             && !exists(bannedRef)
             && hasFreshReservation(noteId, quotaRef)
             && existsAfter(ownerRef)
             && getAfter(ownerRef).data.uid == request.auth.uid
             && noteId == incoming().token
             && incoming().status == 'waiting'
             && incoming().content is string
             && incoming().content.size() <= 1000
             && incoming().style is map
             && incoming().token is string
             && incoming().keys().hasOnly(
                  ['content', 'style', 'token', 'timestamp', 'status']
                )
             && (!tokenRequired() || hasUsableToken(tokenRef));
    }

    // ── note_owners/{noteId} 的建立條件 ────────────────────
    // 只能在建立便利貼的那一批裡一起建立：exists() 看的是這一批之前、
    // existsAfter() 看的是之後。少了「之前不存在」這一條的話，任何人都能
    // 把一張已經在牆上、還沒有投稿者紀錄的舊便利貼（匿名時期的）認領成自己的。
    function canCreateNoteOwner(noteRef) {
      return isMember()
             && incoming().uid == request.auth.uid
             && incoming().keys().hasOnly(['uid', 'createdAt'])
             && incoming().createdAt == request.time
             && !exists(noteRef)
             && existsAfter(noteRef);
    }

    // ── users/{uid} 的寫入條件 ─────────────────────────────
    // 會員資料由前端自己寫（server 只負責簽 custom token，不碰 Firestore，
    // 這樣才不用把 service account 的寫入權限搬進 Nitro）。
    //
    // 之所以敢讓前端寫，是因為 displayName 必須跟 custom token 裡的 lineName
    // claim 一字不差 —— 那個值是 server 從 LINE 的 id_token 取出、截斷後簽進去的，
    // 前端改不了。頭貼是 base64，規則沒辦法驗內容，只能限大小；這與手繪圖
    // 同樣沒有審核路徑，靠後台即時下架處理。
    function canWriteUserProfile(uid) {
      return isMember()
             && request.auth.uid == uid
             && incoming().displayName == request.auth.token.lineName
             && incoming().keys().hasOnly(
                  ['displayName', 'avatar', 'createdAt', 'updatedAt']
                )
             && (!incoming().keys().hasAll(['avatar'])
                 || incoming().avatar.size() <= 30000);
    }

    // ══ 投稿配額 ═══════════════════════════════════════════
    //
    // 規則：每人每 N 分鐘最多 1 張、每天最多 M 張（預設 5 分鐘／3 張）。
    // 設定放 system/editor_rate_limit，後台可改，見 adjustable 的三個欄位。
    //
    // ── 為什麼是「預約制」而不是「寫完再算」──────────────────
    // 直覺的做法是在 canCreateNote 裡 get() 使用者的計數器來判斷。那行不通：
    // 計數器是前端寫的，**攻擊者只要跳過那次寫入，計數就永遠不會前進**，
    // 而規則沒有辦法要求「你必須同時也寫另一份文件」。
    //
    // 所以順序反過來：
    //   1. 先寫 user_quota/{uid}（預約），這一步檢查冷卻與每日上限
    //   2. 再建立便利貼，而 canCreateNote 要求「必須有一張剛發出、
    //      而且指名這個 doc ID 的預約」
    // 跳過第 1 步，第 2 步就過不了。預約指名 doc ID，所以一張預約只能換一張
    // 便利貼；而 queue_pending 只開放 create 不開放 update，同一個 ID 也寫不了第二次。

    function rateLimitConfig() {
      return exists(/databases/$(database)/documents/system/editor_rate_limit)
             ? get(/databases/$(database)/documents/system/editor_rate_limit).data
             : {};
    }

    // request.time 是 UTC。直接取 day() 的話每日額度會在台灣時間早上 8 點重置，
    // 那是營業時間正中間。加 8 小時之後取到的才是台灣當地日期。
    // 沒有補零（"2026-9-5"），但這只是個比對用的鍵，前後端算法一致就好。
    function taipeiDateKey() {
      let local = request.time + duration.value(8, 'h');
      return string(local.year()) + '-' + string(local.month()) + '-' + string(local.day());
    }

    // ── 預約的寫入條件 ────────────────────────────────────
    function canWriteQuota(uid) {
      let cfg = rateLimitConfig();
      let today = taipeiDateKey();
      let prev = resource == null ? {} : resource.data;
      // 跨日就把今天的用量歸零，不管文件裡留著的是哪一天
      let usedToday = prev.get('submitDate', '') == today ? prev.get('submitCount', 0) : 0;
      // pendingNoteId 就是前端的 submissionId，跟著草稿走。
      // 相同代表「同一張便利貼再試一次」——上傳失敗重按不該被冷卻鎖 5 分鐘。
      let isRetry = incoming().pendingNoteId == prev.get('pendingNoteId', '');
      let cooledDown = !prev.keys().hasAll(['lastSubmitAt'])
                       || request.time >= prev.lastSubmitAt
                                          + duration.value(cfg.get('cooldownMinutes', 5), 'm');

      return isMember()
             && request.auth.uid == uid
             && incoming().keys().hasOnly(
                  ['lastSubmitAt', 'submitDate', 'submitCount', 'pendingNoteId']
                )
             // 時間戳必須是伺服器時間，不能自己填一個過去的值把冷卻繞掉
             && incoming().lastSubmitAt == request.time
             && incoming().submitDate == today
             && incoming().pendingNoteId is string
             && incoming().pendingNoteId.size() > 0
             && (
               // 重試：不吃額度、不重置冷卻。跨日的重試才算進新的一天
               (isRetry && incoming().submitCount == (usedToday == 0 ? 1 : usedToday))
               ||
               // 新的一張：要過冷卻，而且今天還有額度
               (!isRetry
                && incoming().submitCount == usedToday + 1
                && (cfg.get('enabled', true) != true
                    || (usedToday < cfg.get('dailyLimit', 3) && cooledDown)))
             );
    }

    // ── 便利貼建立時要驗的預約 ──────────────────────────────
    // 10 分鐘的有效期跟可調的冷卻無關，純粹是不讓一張很久以前的預約還能用。
    // 前端是在手繪圖上傳完、真正要寫入的前一刻才預約，實際只會用到幾秒。
    function hasFreshReservation(noteId, quotaRef) {
      let q = exists(quotaRef) ? get(quotaRef).data : {};
      return q.get('pendingNoteId', '') == noteId
             && q.keys().hasAll(['lastSubmitAt'])
             && request.time < q.lastSubmitAt + duration.value(10, 'm');
    }

    // ── tokens 的更新條件 ──────────────────────────────────
    // 前台送出成功時要把 unused 改成 used —— 只允許這一種轉換、
    // 只能動 status 這個欄位，而且憑證必須還在 30 分鐘有效期內。
    // 這個 update 與 queue_pending 的 create 在同一個 transaction 裡，
    // 所以一樣要求會員身分，否則未登入者可以把別人的憑證燒掉。
    function canUpdateToken() {
      return isStaff()
             || (
               isMember()
               && resource.data.status == 'unused'
               && incoming().status == 'used'
               && incoming().diff(resource.data).affectedKeys().hasOnly(['status'])
               && tokenUnexpired(resource.data)
             );
    }

    // ── stats_daily 的寫入條件 ─────────────────────────────
    // 前台上傳成功後由使用者端累加計數，所以必須開放寫入。送出已經要求登入，
    // 這裡跟著收斂成會員限定，順便把匿名灌水的路堵掉。
    // 限制欄位並要求 date 與 doc ID 一致，避免被塞入任意資料；
    // 計數本身仍可能被會員灌水，但這只是營運數字，沒有安全影響。
    function canWriteDailyStat(dateKey) {
      return isMember()
             && incoming().keys().hasOnly(
                  ['date', 'total', 'hours', 'updatedAt']
                )
             && incoming().date == dateKey;
    }

    // ══ 【過渡期】正式站舊版程式的相容條件 ══════════════════════
    //
    // 正式站與測試站是同一個 Firebase 專案，規則只有一份。正式站跑的還是舊版
    // （origin/main：不登入、匿名投稿、便利貼沒有 uid），測試站跑的是 LINE 登入版。
    // 所以正式組集合在過渡期要**兩種寫法都收**：
    //
    //   舊版的匿名投稿 → 下面這三個 *Legacy 條件（與舊規則逐字相同）
    //   新版的會員投稿 → 上面的 canCreateNote 等
    //
    // 這樣正式站換成新版程式的那一刻不需要同時改規則，兩邊可以分開上線。
    // 代價是過渡期內正式站仍然可以匿名投稿，**封鎖與投稿額度在正式站擋不住人**
    // （繞過登入走舊格式就好）。測試組（_dev）不收舊格式，一律是新規則。
    //
    // 正式站換成新版、穩定一天（讓還開著舊頁面的人都重新整理過）之後：
    // 搜尋「【過渡期】」，刪掉這一段與正式組 match 裡的 `|| ...Legacy(...)`，重新部署。
    //
    // isStaff() 的拆分不在過渡範圍：舊版後台與大螢幕本來就是帳密登入
    // （sign_in_provider = password），舊程式完全不受影響。

    // 【過渡期】舊版匿名投稿：沒有 uid、不需要預約
    function canCreateNoteLegacy(noteId, tokenRef) {
      return noteId == incoming().token
             && incoming().status == 'waiting'
             && incoming().content is string
             && incoming().content.size() <= 1000
             && incoming().style is map
             && incoming().token is string
             && incoming().keys().hasOnly(
                  ['content', 'style', 'token', 'timestamp', 'status']
                )
             && (!tokenRequired() || hasUsableToken(tokenRef));
    }

    // 【過渡期】舊版送出時匿名把憑證改成 used
    function canUpdateTokenLegacy() {
      return resource.data.status == 'unused'
             && incoming().status == 'used'
             && incoming().diff(resource.data).affectedKeys().hasOnly(['status'])
             && tokenUnexpired(resource.data);
    }

    // 【過渡期】舊版送出後匿名累加每日統計
    function canWriteDailyStatLegacy(dateKey) {
      return incoming().keys().hasOnly(
               ['date', 'total', 'hours', 'updatedAt']
             )
             && incoming().date == dateKey;
    }

    // ══ 正式資料 ══════════════════════════════════════════

    // 待播佇列，也是前台的投稿入口
    match /queue_pending/{noteId} {
      // 首頁、等待頁與大螢幕都要讀；內容本來就會公開展示
      allow read: if true;

      // 【過渡期】舊格式放前面：匿名請求時 request.auth 是 null，
      // 先算新版條件的話 $(request.auth.uid) 會出錯。|| 會短路，舊格式成立就不往後算
      allow create: if canCreateNoteLegacy(
                         noteId,
                         /databases/$(database)/documents/tokens/$(noteId)
                       )
                    || canCreateNote(
                         noteId,
                         /databases/$(database)/documents/tokens/$(noteId),
                         /databases/$(database)/documents/user_quota/$(request.auth.uid),
                         /databases/$(database)/documents/banned_users/$(request.auth.uid),
                         /databases/$(database)/documents/note_owners/$(noteId)
                       );

      // 送出後就不能再改；只有大螢幕播完或後台管理才會刪
      allow update: if false;
      allow delete: if isStaff();
    }

    // 已播放
    match /queue_history/{noteId} {
      allow read: if true;
      // 只有大螢幕（moveToHistory）與後台會寫入或清理
      allow create, update, delete: if isStaff();
    }

    // 上傳憑證
    match /tokens/{tokenId} {
      // checkTokenStatus 要讀單一文件。doc ID 是 Firestore 隨機 ID，
      // 猜不到；list 不開放，所以也無法列舉。
      allow get: if true;
      allow list: if isStaff();

      // 只有後台可以發憑證
      allow create: if isStaff();

      allow update: if canUpdateToken() || canUpdateTokenLegacy();  // 【過渡期】
      allow delete: if isStaff();
    }

    // 每日上傳統計（預聚合）
    match /stats_daily/{dateKey} {
      // 只有後台會看統計
      allow read: if isStaff();
      allow create, update: if canWriteDailyStat(dateKey) || canWriteDailyStatLegacy(dateKey);  // 【過渡期】
    }

    // LINE 會員資料。doc ID 就是 Firebase uid（= line:<LINE userId>）。
    // 只有本人與後台讀得到 —— 這裡放的是暱稱與頭貼，不該像便利貼那樣公開。
    // 便利貼上要顯示的名牌是送出時複製一份進 style，不是渲染時回來讀這裡，
    // 否則首頁 100 張就是 100 次額外讀取，而且使用者改暱稱會連帶改掉舊便利貼。
    match /users/{uid} {
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update: if canWriteUserProfile(uid);
      allow delete: if isStaff();
    }

    // 投稿配額。與 users 分開存，是因為兩者的寫入條件完全不同：
    // 個人資料隨時可以更新，配額只能照規則往前推。混在一份文件裡的話，
    // 每一次寫入都得先分辨「這是在改暱稱還是在預約」，規則會變得很難讀。
    match /user_quota/{uid} {
      // 前端要先讀目前用量才算得出下一個 submitCount；後台要看有沒有人在灌
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update: if canWriteQuota(uid);
      // 使用者不能自己清掉配額；後台刪除個資時會一起清
      allow delete: if isStaff();
    }

    // 停權名單。存在就是停權，由 canCreateNote 檢查。
    // 本人讀得到自己那一份：前台要在按送出時告訴他「這個帳號已停止投稿」，
    // 而不是讓規則擋下來之後顯示一句看不出原因的錯誤。
    // 刪除個人資料時**不會**一起刪 —— 否則申請刪除個資就等於解除封鎖。
    match /banned_users/{uid} {
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update, delete: if isStaff();
    }

    // 便利貼的投稿者。doc ID 與便利貼相同（queue_pending 搬到 queue_history 時
    // ID 不變，所以這一份不用跟著搬）。本人讀得到自己的（「我的便利貼」用
    // where('uid', '==', 自己) 查），後台全部讀得到。
    // 刪便利貼時由後台一起刪；刪除個人資料時也會刪，之後就無法追溯投稿者。
    match /note_owners/{noteId} {
      allow read: if isStaff() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if canCreateNoteOwner(/databases/$(database)/documents/queue_pending/$(noteId));
      allow update: if false;
      allow delete: if isStaff();
    }

    // ══ 測試資料（NUXT_PUBLIC_FIRESTORE_SUFFIX=_dev）══════════
    // 條件與正式組完全相同，只有集合名稱與 tokens 路徑帶了 _dev。

    match /queue_pending_dev/{noteId} {
      allow read: if true;

      allow create: if canCreateNote(
                         noteId,
                         /databases/$(database)/documents/tokens_dev/$(noteId),
                         /databases/$(database)/documents/user_quota_dev/$(request.auth.uid),
                         /databases/$(database)/documents/banned_users_dev/$(request.auth.uid),
                         /databases/$(database)/documents/note_owners_dev/$(noteId)
                       );

      allow update: if false;
      allow delete: if isStaff();
    }

    match /queue_history_dev/{noteId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /tokens_dev/{tokenId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if canUpdateToken();
      allow delete: if isStaff();
    }

    match /stats_daily_dev/{dateKey} {
      allow read: if isStaff();
      allow create, update: if canWriteDailyStat(dateKey);
    }

    match /users_dev/{uid} {
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update: if canWriteUserProfile(uid);
      allow delete: if isStaff();
    }

    match /user_quota_dev/{uid} {
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update: if canWriteQuota(uid);
      allow delete: if isStaff();
    }

    match /banned_users_dev/{uid} {
      allow read: if isStaff() || (isMember() && request.auth.uid == uid);
      allow create, update, delete: if isStaff();
    }

    match /note_owners_dev/{noteId} {
      allow read: if isStaff() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if canCreateNoteOwner(/databases/$(database)/documents/queue_pending_dev/$(noteId));
      allow update: if false;
      allow delete: if isStaff();
    }

    // ── system/*：設定文件（正式與測試共用）────────────────────
    match /system/{docId} {
      // 前台要讀 editor_token_requirement 與 editor_geo_fence，
      // 大螢幕要讀 canvas_video，掃碼頁要讀 active_token
      allow read: if true;
      allow write: if isStaff();
    }

    // 其餘一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
